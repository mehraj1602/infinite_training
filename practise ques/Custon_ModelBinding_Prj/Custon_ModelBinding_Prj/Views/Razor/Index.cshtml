
@{
    ViewBag.Title = "Index";
}

<h2>Index</h2>
@* switching between C# code and HTML using "@"symbol *@
@for (int i = 1; i <= 10; i++)
{
    <b>@i</b>
}

@* using razor block *@
@{
    int evennumtotal = 0;
    int oddnumtotal = 0;

    for (int i = 1; i <= 10; i++)
    {
        if (i % 2 == 0)
        {
            evennumtotal = evennumtotal + 1;
        }
        else
        {
            oddnumtotal += 1;
        }
    }
}
<h3>Sum of even numbers = @evennumtotal</h3>
<h3>Sum of odd numbers = @oddnumtotal</h3>
<br />
@* using <text> element or @: to switch between code and html *@

@for (int i = 1; i <= 10; i++)
{
    <b>@i</b>
    if (i % 2 == 0)
    {
        <text> - Even </text>
    }
    else
    {
        <text> - Odd </text
        }
        <br />
    }

@* rewrite the above as below *@
<br />

@for (int i = 1; i <= 10; i++)
{
    <b>@i</b>
    if (i % 2 == 0)
    {
        @: - Even
    }
    else
    {
        @: - Odd
    }
    <br />
}

