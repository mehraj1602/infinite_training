@model Week8_CodingTest_Part2.Models.Movies

<h2>Add Movie</h2>

@using (Html.BeginForm())
{
    <p>
        Movie Name:
        @Html.TextBoxFor(m => m.Moviename)
    </p>

    <p>
        Director Name:
        @Html.TextBoxFor(m => m.DirectorName)
    </p>

    <p>
        Release Date:
        @Html.TextBoxFor(
            m => m.DateofRelease,
            "{0:yyyy-MM-dd}",
            new { type = "date" }
        )
    </p>

    <input type="submit" value="Save" />
}